# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored.
#
# Stack 04 must be applied and its Vault bootstrapped first: this stack does not
# create vtafarm-api-vault, and the API waits for it.

# --- Where to install ------------------------------------------------------
# Leave empty to read the kubeconfig stack 03 wrote for the cluster whose
# directory name matches this one.
kubeconfig_path = ""

# --- Identity --------------------------------------------------------------
# Everything else is derived: vtafarm.<domain>, vtafarm-api.<domain>,
# vta-<name>.<domain>, the wildcard certificate, WebAuthn and CORS.
domain     = "example.org"
acme_email = "ops@example.org"

# `make outputs-rke2 CLUSTER=<name>` prints this.
cluster_ingress_ip = ""

# --- Cloudflare ------------------------------------------------------------
cloudflare_api_token = ""
cloudflare_zone_id   = ""

# --- DID hosting -----------------------------------------------------------
# vtafarm-api's own keypair: `make gen-keypair` in the vtafarm-api repo.
did_hosting_did         = ""
did_hosting_private_key = ""

# --- VTA Claim -------------------------------------------------------------
# The Farm DID must publish an assertionMethod matching farm_signing_key and a
# TrustTaskHTTPS service at https://<api_host>/trust-task.
farm_did         = "did:webvh:<scid>:dids.example.org:vtafarm-auth"
farm_signing_key = ""

# --- Monitoring ------------------------------------------------------------
# openssl rand -hex 32. Empty disables /api/v1/monitor/*.
monitor_token = ""

# --- Workload placement ---------------------------------------------------
# Deploy the complete feature with mode=disabled first. After backup/restore
# validation, list the two canary VTA setup-session numeric IDs. Change only
# mode to enabled after both canaries have completed and retained their data.
placement = {
  mode               = "disabled"
  canary_session_ids = []
  # Keep one worker in disabled mode so it can publish node health without
  # moving workloads. Set to 0 only when intentionally stopping reconciliation.
  worker_replicas       = 1
  worker_cpu_request    = "25m"
  worker_memory_request = "128Mi"
  worker_memory_limit   = "256Mi"
}

# --- Versions --------------------------------------------------------------
# The release this farm runs. Each chart's appVersion is its image tag, so
# these two numbers pin the images too.
vtafarm_version     = "0.1.0"
vtafarm_api_version = "0.1.0"
