hcloud_token = "REPLACE_ME"

# Rancher UI -> user menu -> Account & API Keys -> Create API Key.
rancher_api_url   = "https://rancher.example.com"
rancher_token_key = "token-REPLACE_ME:REPLACE_ME"

# Hetzner location for every server and the cluster load balancer:
# fsn1 = Falkenstein, nbg1 = Nuremberg, hel1 = Helsinki,
# ash = Ashburn, hil = Hillsboro, sin = Singapore.
location = "nbg1"

# Pin the Rancher-managed Kubernetes release. Upgrade one minor at a time.
rke2_version = "v1.35.9+rke2r1"

# Set dev = true for one all-in-one RKE2 server with no load balancer.
# server_count is ignored. Every environment always has a private node network.
dev = false

# RKE2 server-node shape. Outside dev, server_count must be odd: 3, 5, 7, or 9.
# Common x86 types include cx23, cx33, cx43, cx53, cpx22, and cpx32.
server_count = 3
server_type  = "cx33"

# Optional dedicated workers use their own count and server type. In dev they
# are always pinned to location. Outside dev, false pins every worker and true
# lets Hetzner choose automatically and requires
# the worker type to be confined to the cluster's network zone, because the
# private network is attached only after server creation.
worker_count         = 0
worker_type          = "cx23"
worker_auto_location = false

# Keep false unless workloads using emptyDir have been verified safe to recreate.
drain_timeout_seconds               = 1800
control_plane_delete_empty_dir_data = false
worker_delete_empty_dir_data        = false

# Reuse an existing SSH key from this Hetzner project.
# Unless you changed it, the name is <k3s_cluster_name>-admin. See stack 01.
ssh_key_name = "k3s-rancher-admin"

# Replace with your workstation address, for example 203.0.113.7/32.
ssh_allowed_cidrs = [
  "0.0.0.0/0"
]

# Optional node reservations. Set all five values together or leave all five
# commented out. The module preserves kubelet's filesystem eviction defaults.
# kube_reserved_cpu              = "250m"
# kube_reserved_memory           = "256Mi"
# system_reserved_cpu            = "250m"
# system_reserved_memory         = "256Mi"
# eviction_hard_memory_available = "512Mi"

# Optional staged rollout. Omit this to apply reservations to every node.
# kubelet_reservation_node_names = ["<cluster-name>-server-1"]

# Optional request for each Rancher cattle-cluster-agent replica. This does not
# impose a memory limit.
# cluster_agent_memory_request = "1Gi"
