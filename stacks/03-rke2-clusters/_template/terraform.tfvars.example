hcloud_token = "REPLACE_ME"

# Rancher UI -> user menu -> Account & API Keys -> Create API Key.
rancher_api_url   = "https://rancher.example.com"
rancher_token_key = "token-REPLACE_ME:REPLACE_ME"

# Hetzner location for pinned nodes and the cluster load balancer. It also
# selects the private-network zone:
# fsn1 = Falkenstein, nbg1 = Nuremberg, hel1 = Helsinki,
# ash = Ashburn, hil = Hillsboro, sin = Singapore.
location = "nbg1"

# Pin the Rancher-managed Kubernetes release. Upgrade one minor at a time.
rke2_version = "v1.35.9+rke2r1"

# Set dev = true with one server-pool node for an all-in-one RKE2 server with no
# load balancer. Migration mode temporarily permits legacy plus one replacement.
# Every environment always has a private node network.
dev = false

# Every machine belongs to a named pool. The reserved "legacy" pool uses the
# original server-N and worker-N names so an existing cluster can adopt this
# model without replacing nodes. Other pools include their name in each node.
server_pools = {
  legacy = {
    count         = 3
    server_type   = "cx33"
    auto_location = false
  }
}

# Dedicated workers are optional. In dev every pool is pinned to location.
# Outside dev, auto_location=false pins either kind of pool; true omits the
# location and lets Hetzner choose. The provider cannot express a preferred
# location followed by fallbacks, and the type must be confined to the
# cluster's network zone.
worker_pools = {}

# Example worker pool:
# worker_pools = {
#   legacy = {
#     count         = 3
#     server_type   = "cx33"
#     auto_location = false
#   }
# }
#
# A safe cx33 -> cx43 server migration takes two separate applies:
#   1. Add the green entry and set server_pool_migration=true, then apply.
#   2. After all new nodes are Ready, remove legacy and set migration false.
#      `make apply-rke2` evacuates Longhorn, drains, and retires each cx33 node
#      through Rancher before OpenTofu deletes any VM.
#
# server_pool_migration = true
# server_pools = {
#   legacy = {
#     count         = 3
#     server_type   = "cx33"
#     auto_location = false
#   }
#   green = {
#     count         = 3
#     server_type   = "cx43"
#     auto_location = true
#   }
# }

# Keep false unless workloads using emptyDir have been verified safe to recreate.
drain_timeout_seconds               = 1800
control_plane_delete_empty_dir_data = false
worker_delete_empty_dir_data        = false

# Reuse an existing SSH key from this Hetzner project.
# Unless you changed it, the name is <k3s_cluster_name>-admin. See stack 01.
ssh_key_name = "k3s-rancher-admin"

# Replace with your workstation address, for example 203.0.113.7/32.
ssh_allowed_cidrs = [
  "0.0.0.0/0"
]

# Optional node reservations. Set all five values together or leave all five
# commented out. The module preserves kubelet's filesystem eviction defaults.
# kube_reserved_cpu              = "250m"
# kube_reserved_memory           = "256Mi"
# system_reserved_cpu            = "250m"
# system_reserved_memory         = "256Mi"
# eviction_hard_memory_available = "512Mi"

# Optional staged rollout. Omit this to apply reservations to every node.
# kubelet_reservation_node_names = ["<cluster-name>-server-1"]

# Optional request for each Rancher cattle-cluster-agent replica. This does not
# impose a memory limit.
# cluster_agent_memory_request = "1Gi"
