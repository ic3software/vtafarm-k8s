# Copy to terraform.tfvars and adjust. terraform.tfvars is gitignored.
#
# Every value below has a working default in variables.tf. The defaults match a
# stack 03 cluster built with its own defaults (three cx33 nodes, all
# schedulable), so an unedited copy is usually correct.

# --- Where to install ------------------------------------------------------
# Leave empty to read the kubeconfig stack 03 wrote for the cluster whose
# directory name matches this one. Set it only if the file lives elsewhere.
kubeconfig_path = ""

# --- Storage ---------------------------------------------------------------
# Longhorn becomes the default class, demoting the hcloud-volumes class the RKE2
# module installs. Each replica costs another volume-size of node disk.
longhorn_version           = "1.12.1"
longhorn_replica_count     = 1
longhorn_node_drain_policy = "block-for-eviction-if-contains-last-replica"
longhorn_default_class     = true

# Reuse the private bucket and S3 credential pair used by the other backup
# layers. The default prefix isolates this cluster at longhorn/<cluster-name>.
# The schedule is evaluated in UTC and keeps 30 daily backups per volume.
longhorn_backup_enabled       = true
longhorn_backup_s3_endpoint   = "https://nbg1.your-objectstorage.com"
longhorn_backup_s3_region     = "nbg1"
longhorn_backup_s3_bucket     = "my-globally-unique-k3s-backups"
longhorn_backup_s3_prefix     = ""
longhorn_backup_s3_access_key = ""
longhorn_backup_s3_secret_key = ""
longhorn_backup_schedule      = "0 0 * * *"
longhorn_backup_retention     = 30

# --- Vault -----------------------------------------------------------------
# vault_replicas must be odd and cannot exceed the schedulable node count: the
# chart pins one Vault pod per node, so a fourth peer would stay Pending.
vault_chart_version = "0.33.0"
vault_replicas      = 3
vault_data_size     = "10Gi"
transit_data_size   = "1Gi"
storage_class       = "longhorn"

# --- cert-manager ----------------------------------------------------------
# Issues the internal Vault certificates. Unrelated to the cert-manager stack
# 02 installs on the management cluster, but kept on the same version.
cert_manager_version = "v1.21.1"
