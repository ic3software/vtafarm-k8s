# Copy to terraform.tfvars and adjust. terraform.tfvars is gitignored.

# Leave empty to use stack 03's kubeconfig for this cluster.
kubeconfig_path = ""

# Opt-in. When false, this stack owns no Kubernetes or Hetzner resources, so
# environments that do not want monitoring can still apply it as a safe no-op.
observability_enabled = false

monitoring_namespace          = "monitoring"
kube_prometheus_stack_version = "93.3.0"

# Prometheus uses a dedicated Hetzner Cloud Volume rather than Longhorn. The
# module creates this Retain StorageClass through the already-installed hcloud
# CSI driver. Keep retention_size below storage_size for WAL and compaction.
prometheus_storage_class  = "hcloud-volumes-retain"
prometheus_storage_size   = "20Gi"
prometheus_retention      = "30d"
prometheus_retention_size = "16GB"

prometheus_scrape_interval     = "30s"
prometheus_evaluation_interval = "30s"

prometheus_replicas = 1

prometheus_cpu_request    = "250m"
prometheus_cpu_limit      = null
prometheus_memory_request = "1Gi"
prometheus_memory_limit   = "3Gi"

# Thanos keeps the same 30-day history in object storage independently of the
# Prometheus PVC. A shared private bucket is safe when Thanos has an isolated
# prefix and scoped S3 credentials. The endpoint has no https:// or path.
thanos_enabled       = true
thanos_chart_version = "0.49.0"

thanos_s3_bucket     = "replace-with-thanos-bucket"
# Empty defaults to thanos/<stack-directory-name>, for example
# thanos/rke2-vtafarm-dev.
thanos_s3_prefix     = ""
thanos_s3_endpoint   = "nbg1.your-objectstorage.com"
thanos_s3_region     = "nbg1"
thanos_s3_access_key = "replace-with-access-key"
thanos_s3_secret_key = "replace-with-secret-key"

thanos_retention                 = "30d"
thanos_query_replicas            = 2
thanos_query_frontend_replicas   = 2
thanos_storegateway_replicas     = 2
thanos_storegateway_storage_class = "longhorn"
thanos_storegateway_storage_size  = "3Gi"
thanos_compactor_storage_class = "hcloud-volumes"
thanos_compactor_storage_size  = "50Gi"

# Loki and Alloy run in the separate logging namespace. Loki stores durable
# data in one private loki bucket with cluster-scoped prefixes such as
# rke2-vtafarm-dev-loki-chunks and rke2-vtafarm-dev-loki-ruler. Create the
# bucket before apply. Empty S3 connection fields reuse the Thanos values.
loki_enabled        = true
logging_namespace   = "logging"
loki_chart_version  = "21.4.0"
alloy_chart_version = "1.16.0"

loki_s3_chunks_bucket = "loki"
loki_s3_ruler_bucket  = "loki"
loki_s3_endpoint      = ""
loki_s3_region        = ""
loki_s3_access_key    = ""
loki_s3_secret_key    = ""

# Development topology: 1 Loki replica, 1 gateway, and one 10Gi retained
# Hetzner Volume. For staging and production, set these to 3, 2, and 20Gi.
loki_replicas         = 1
loki_gateway_replicas = 1
loki_storage_class    = "hcloud-volumes-retain"
loki_storage_size     = "10Gi"
loki_retention        = "720h"

# Prometheus, Thanos Query, Loki, Alloy, and Grafana remain private ClusterIP
# services. Use kubectl port-forward for operator access; tenant telemetry goes
# through an authorized API rather than exposing the backends directly.
grafana_enabled       = true
alertmanager_enabled  = true
alertmanager_replicas = 1

# Normal-operation defaults. Development clusters may use 1m alert windows and
# 10s/30s Alertmanager grouping for faster end-to-end alert verification.
tenant_cpu_usage_window             = "5m"
tenant_alert_warning_for            = "10m"
tenant_alert_critical_for           = "5m"
alertmanager_tenant_group_wait      = "30s"
alertmanager_tenant_group_interval  = "1m"

# Generate with `openssl rand -hex 32`. Stack 05 for this cluster must use the
# same token and revision. Increment the revision whenever the token changes.
alertmanager_webhook_enabled        = false
alertmanager_webhook_token          = ""
alertmanager_webhook_token_revision = 1
