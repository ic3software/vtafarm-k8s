#cloud-config
hostname: ${hostname}
preserve_hostname: false
fqdn: ${hostname}

package_update: true
package_upgrade: true
packages:
  - curl
  - ca-certificates
  - jq
  - open-iscsi
  - nfs-common

write_files:
  - path: /etc/rancher-node-bootstrap.env
    permissions: "0600"
    owner: root:root
    encoding: b64
    content: ${base64encode("NODE_PRIVATE_IP=\"${node_private_ip}\"\nPRIVATE_IFACE_MTU=\"${private_interface_mtu}\"\n")}

  - path: /etc/rancher/node-registration.sh
    permissions: "0700"
    owner: root:root
    encoding: b64
    content: ${base64encode("#!/usr/bin/env bash\nset -euo pipefail\n${registration_script}\n")}

  - path: /usr/local/bin/rancher-node-bootstrap.sh
    permissions: "0700"
    owner: root:root
    encoding: b64
    content: ${base64encode(bootstrap_script)}

  - path: /etc/sysctl.d/99-kubernetes.conf
    permissions: "0644"
    owner: root:root
    content: |
      fs.inotify.max_user_instances = 8192
      fs.inotify.max_user_watches = 524288
      vm.max_map_count = 262144
      net.ipv4.ip_forward = 1
      net.bridge.bridge-nf-call-iptables = 1
      net.bridge.bridge-nf-call-ip6tables = 1

runcmd:
  - [modprobe, overlay]
  - [modprobe, br_netfilter]
  - [systemctl, restart, systemd-sysctl]
  - [systemctl, enable, --now, iscsid]
  - [bash, /usr/local/bin/rancher-node-bootstrap.sh]
