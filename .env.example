# Copy to .env and fill in. Gitignored, and the only file handed over by hand.
# See docs/remote-state.md.

TF_STATE_BUCKET=my-globally-unique-bucket

# Everything OpenTofu owns goes under this folder, in tfstate/ and tfvars/.
# Do not change it after migrating: OpenTofu would find no state.
TF_PREFIX=opentofu

# Console -> Security -> S3 credentials; the pair the backups already use.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

AWS_REGION=nbg1
AWS_ENDPOINT_URL_S3=https://nbg1.your-objectstorage.com
